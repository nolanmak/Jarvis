# --- Node daemon (legacy) ---
GROQ_API_KEY=
CEREBRAS_API_KEY=
COMPOSIO_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
DASHBOARD_PORT=3000
IMPORTANT_SENDERS=email1@example.com,email2@example.com
GITHUB_WEBHOOK_SECRET=   # openssl rand -hex 32

# --- Rust daemon additions ---
# Discord query bot (optional — enables `@mention` + DM queries against the wiki).
# Requires MESSAGE CONTENT intent enabled for the bot in Discord dev portal.
DISCORD_QUERY_CHANNEL_ID=        # optional — defaults to DISCORD_CHANNEL_ID. Set only if you want queries in a different channel.
DISCORD_ALLOWED_USER_ID=         # your Discord user ID; messages from anyone else are ignored
DISCORD_APPROVAL_TIMEOUT_SECS=3600

# Encrypted sparse bundle (macOS only). Overrides for vault scripts.
# AUGMENTAGENT_VAULT_PATH=$HOME/augmentagent-vault.sparsebundle
# AUGMENTAGENT_MOUNT_POINT=/Volumes/augmentagent
# AUGMENTAGENT_VOLNAME=augmentagent
# AUGMENTAGENT_VAULT_SERVICE=augmentagent-vault
# AUGMENTAGENT_VAULT_SIZE=2g

# Rust runtime knobs
RUST_LOG=info
# CLAUDE_CLI=claude              # override path to the `claude` binary
# AUGMENTAGENT_DB=./data.db      # defaults to ./data.db (symlink into vault after init)

# --- Grocery sidecar ---
GROCERY_PROVIDER=giant
# GROCERY_SOCKET=                # override the sidecar Unix-socket path
# GROCERY_CHROME_PROFILE=        # default: ~/.augmentagent/grocery/chrome-profile
# GROCERY_PROXY=                 # e.g. socks5://127.0.0.1:40000 for Cloudflare WARP
# GROCERY_HEADLESS=0             # 1 = headless Chrome; default 0 (visible browser)
GIANT_EMAIL=
GIANT_PASSWORD=
GIANT_STORE_ID=                  # numeric store id, e.g. 356
# GIANT_STORE_BASE_URL=https://giantfoodstores.com   # override only if using a sibling brand (Stop & Shop, Food Lion, ...)

