# --- Node daemon (legacy) ---
GROQ_API_KEY=
CEREBRAS_API_KEY=
COMPOSIO_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
DASHBOARD_PORT=3000
IMPORTANT_SENDERS=email1@example.com,email2@example.com
GITHUB_WEBHOOK_SECRET=   # openssl rand -hex 32

# --- Rust daemon additions ---
# Discord query bot (optional — enables `@mention` + DM queries against the wiki).
# Requires MESSAGE CONTENT intent enabled for the bot in Discord dev portal.
DISCORD_QUERY_CHANNEL_ID=        # optional — defaults to DISCORD_CHANNEL_ID. Set only if you want queries in a different channel.
DISCORD_ALLOWED_USER_ID=         # your Discord user ID; messages from anyone else are ignored
DISCORD_APPROVAL_TIMEOUT_SECS=3600

# Encrypted sparse bundle (macOS only). Overrides for vault scripts.
# AUGMENTAGENT_VAULT_PATH=$HOME/augmentagent-vault.sparsebundle
# AUGMENTAGENT_MOUNT_POINT=/Volumes/augmentagent
# AUGMENTAGENT_VOLNAME=augmentagent
# AUGMENTAGENT_VAULT_SERVICE=augmentagent-vault
# AUGMENTAGENT_VAULT_SIZE=2g

# Rust runtime knobs
RUST_LOG=info
# CLAUDE_CLI=claude              # override path to the `claude` binary
# AUGMENTAGENT_DB=./data.db      # defaults to ./data.db (symlink into vault after init)

# --- Invoice automation (PERSONAL/BUSINESS DATA — lives here, NOT in git) ---
# `.env` is gitignored. Source of truth for the invoice generator's identity,
# client, and rate. Recipient email is set separately via the dashboard /
# `!invoice recipient` (stored in the gitignored sqlite DB). Leave blank to
# keep the generator disabled (it errors loudly rather than guessing).
INVOICE_FROM_LINES=Your Business|Your Name|123 Example St|City, ST 00000|555-555-5555
INVOICE_BILL_TO=Client Name
INVOICE_HOURS=0
INVOICE_RATE=0
INVOICE_GH_REPO=                 # owner/name slug billed PRs are read from (gh --repo)
INVOICE_GH_AUTHOR=               # GitHub login whose merged PRs are billed
# INVOICE_OUT_DIR=/tmp/invoices  # where generated PDFs are written

# --- Automated git commit identity (daemon wiki-migrate commits) ---
# Neutral defaults if unset: "AugmentAgent <augmentagent@localhost>".
AUGMENTAGENT_GIT_AUTHOR_NAME=
AUGMENTAGENT_GIT_AUTHOR_EMAIL=

