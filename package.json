{
  "name": "augmentagent",
  "version": "1.0.0",
  "description": "Self-hosted personal assistant with message triage, reply approvals, and relationship reminders",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "npm run tailwind:build && tsc",
    "tailwind:build": "tailwindcss -i ./tailwind.input.css -o ./public/tailwind.css --minify",
    "start": "node dist/index.js",
    "test": "tsc && node --test test/*.test.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop augmentagent",
    "pm2:restart": "pm2 restart augmentagent",
    "pm2:logs": "pm2 logs augmentagent",
    "fetch:install": "bash sidecars/fetch/setup.sh",
    "fetch:build": "cd sidecars/fetch && npm run build",
    "fetch:sidecar": "cd sidecars/fetch && npm start",
    "fetch:smoke": "cd sidecars/fetch && npm run smoke --"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nolanmak/Jarvis.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nolanmak/Jarvis/issues"
  },
  "homepage": "https://github.com/nolanmak/Jarvis#readme",
  "dependencies": {
    "@ai-sdk/groq": "^4.0.70",
    "@ai-sdk/provider": "^4.0.34",
    "@composio/client": "^0.1.0-alpha.76",
    "@openai/agents": "^0.21.0",
    "@openai/agents-extensions": "^0.21.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.25.1",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "multer": "^2.0.1",
    "openai": "^7.43.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
