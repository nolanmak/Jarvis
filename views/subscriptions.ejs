<%- include('partials/header', { page: 'subscriptions' }) %>

<div class="space-y-6">
  <h1 class="text-xl font-semibold">Channel Subscriptions</h1>

  <!-- ============================================================ -->
  <!-- 1. CONNECTIONS — top-of-page status of each integration       -->
  <!-- ============================================================ -->
  <section>
    <h2 class="text-sm font-semibold uppercase text-gray-400 mb-2">Connections</h2>
    <p class="text-xs text-gray-500 mb-3">
      Connect an integration first. Connecting <em>does not</em> auto-subscribe to anything —
      add subscriptions individually below for the channels you want watched.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Discord -->
      <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-sm font-semibold">Discord</h3>
          <div class="flex items-center gap-2">
            <span id="discord-status-badge" class="text-xs px-2 py-0.5 rounded bg-gray-800">…</span>
            <button id="discord-connect-btn"
                    onclick="openDiscordConnectModal()"
                    class="hidden px-3 py-1 rounded-md text-xs font-medium bg-accent text-white hover:bg-accent/90 transition-colors">
              Connect Discord
            </button>
          </div>
        </div>
        <p class="text-xs text-gray-500 mb-2">
          Discord has no OAuth that allows DM polling, so the agent uses your real browser session.
          One-click capture via the bookmarklet — no DevTools required.
        </p>
        <div id="discord-status-body" class="text-sm text-gray-400">Checking…</div>
      </div>

      <!-- Slack -->
      <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-sm font-semibold">Slack</h3>
          <a href="/oauth/slack/start"
             class="px-3 py-1 rounded-md text-xs font-medium bg-accent text-white hover:bg-accent/90 transition-colors">
            Connect workspace
          </a>
        </div>
        <p class="text-xs text-gray-500 mb-2">
          OAuth via Composio. After connecting, click <span class="text-gray-300">Manage channels</span>
          to bulk-subscribe with checkboxes (no per-channel modal).
        </p>
        <div id="slack-workspaces-list" class="text-sm text-gray-400">Loading…</div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 2. SUBSCRIPTIONS — channels we actively watch                 -->
  <!-- ============================================================ -->
  <section>
    <div class="flex items-center justify-between mb-2">
      <h2 class="text-sm font-semibold uppercase text-gray-400">Subscriptions</h2>
      <button
        onclick="openAddModal()"
        class="px-3 py-1.5 rounded-md text-sm font-medium bg-accent text-white hover:bg-accent/90 transition-colors">
        Subscribe to a channel
      </button>
    </div>
    <p class="text-xs text-gray-500 mb-3">
      Each row watches ONE channel (DM or group). Modes:
      <span class="font-medium text-white">priority</span> = triage → draft → approval ·
      <span class="font-medium text-white">digest</span> = daily summary ·
      <span class="font-medium text-white">store_only</span> = raw persistence.
    </p>

    <div class="bg-gray-900 border border-gray-800 rounded-lg overflow-hidden">
      <table class="w-full">
        <thead>
          <tr class="border-b border-gray-800 text-left">
            <th class="px-4 py-2 text-xs text-gray-500 font-medium">Platform</th>
            <th class="px-4 py-2 text-xs text-gray-500 font-medium">Channel</th>
            <th class="px-4 py-2 text-xs text-gray-500 font-medium">Mode</th>
            <th class="px-4 py-2 text-xs text-gray-500 font-medium">Last seen</th>
            <th class="px-4 py-2 text-xs text-gray-500 font-medium">Last digest</th>
            <th class="px-4 py-2 text-xs text-gray-500 font-medium"></th>
          </tr>
        </thead>
        <tbody id="sub-table-body">
          <%- include('partials/subscription-rows', { subs: subs }) %>
        </tbody>
      </table>
    </div>
  </section>
</div>

<!-- Channel-manager overlay: per-workspace bulk select with checkboxes -->
<div id="channels-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4"
     onclick="if(event.target===this) closeChannelManager()">
  <div class="bg-gray-900 border border-gray-700 rounded-xl p-6 w-full max-w-2xl max-h-[85vh] flex flex-col">
    <div class="flex items-center justify-between mb-3">
      <div>
        <h2 class="text-lg font-semibold">Channels in <span id="cm-workspace-name" class="text-accent"></span></h2>
        <p class="text-xs text-gray-500">Check channels to subscribe. Already-subscribed rows are pre-checked.</p>
      </div>
      <button onclick="closeChannelManager()" class="text-gray-400 hover:text-white">✕</button>
    </div>

    <div class="flex flex-wrap gap-2 mb-3 text-xs">
      <div class="flex items-center gap-1">
        <label class="text-gray-400">Mode for new subs:</label>
        <select id="cm-mode" class="bg-gray-900 border border-gray-700 rounded-md px-2 py-1">
          <option value="priority">priority</option>
          <option value="digest" selected>digest</option>
          <option value="store_only">store_only</option>
        </select>
      </div>
      <div class="flex items-center gap-1 ml-auto">
        <label class="text-gray-400">Filter:</label>
        <select id="cm-filter" class="bg-gray-900 border border-gray-700 rounded-md px-2 py-1" onchange="renderCmList()">
          <option value="all" selected>All</option>
          <option value="dms">DMs only</option>
          <option value="channels">Channels only</option>
          <option value="subscribed">Subscribed</option>
        </select>
        <input id="cm-search" type="text" placeholder="search…"
               oninput="renderCmList()"
               class="bg-gray-900 border border-gray-700 rounded-md px-2 py-1 w-32" />
      </div>
    </div>

    <div class="flex gap-3 mb-2 text-xs">
      <button type="button" onclick="cmSelectAll(true)" class="text-blue-400 hover:text-blue-300">Select all visible</button>
      <button type="button" onclick="cmSelectAll(false)" class="text-blue-400 hover:text-blue-300">Clear all visible</button>
      <span id="cm-count" class="ml-auto text-gray-500"></span>
    </div>

    <div id="cm-list" class="flex-1 overflow-y-auto border border-gray-800 rounded-md divide-y divide-gray-800 bg-gray-950">
      <div class="p-4 text-center text-sm text-gray-400">Loading channels…</div>
    </div>

    <div id="cm-error" class="hidden text-sm text-red-400 mt-2"></div>

    <div class="flex gap-2 justify-end mt-4">
      <button type="button" onclick="closeChannelManager()"
              class="px-3 py-1.5 rounded-md text-sm font-medium text-gray-400 hover:text-white hover:bg-gray-800">
        Cancel
      </button>
      <button type="button" onclick="cmApply(false)"
              class="px-3 py-1.5 rounded-md text-sm font-medium bg-accent text-white hover:bg-accent/90">
        Subscribe selected
      </button>
      <button type="button" onclick="cmApply(true)" title="Subscribe checked + unsubscribe unchecked"
              class="px-3 py-1.5 rounded-md text-sm font-medium bg-accent/70 text-white hover:bg-accent/80">
        Sync (replace)
      </button>
    </div>
  </div>
</div>

<!-- Discord-connect modal: bookmarklet + open-Discord button + live status poller -->
<div id="discord-connect-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4"
     onclick="if(event.target===this) closeDiscordConnectModal()">
  <div class="bg-gray-900 border border-gray-700 rounded-xl p-6 w-full max-w-xl">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-lg font-semibold">Connect Discord</h2>
        <p class="text-xs text-gray-500">One-click capture from a logged-in Discord browser tab.</p>
      </div>
      <button onclick="closeDiscordConnectModal()" class="text-gray-400 hover:text-white">✕</button>
    </div>

    <ol class="text-sm text-gray-300 space-y-3 list-decimal pl-5 mb-4">
      <li>
        Drag this link to your bookmarks bar:
        <a id="discord-bookmarklet-link" href="#"
           class="ml-1 inline-block px-3 py-1 bg-accent text-white rounded-md text-xs font-medium hover:bg-accent/90"
           onclick="event.preventDefault(); alert('Drag this to your bookmarks bar (don’t click)')">
          augmentagent · grab Discord creds
        </a>
        <span class="text-xs text-gray-500 block mt-1">
          (browsers block clicking <code class="text-gray-400">javascript:</code> URLs directly — drag-only)
        </span>
      </li>
      <li>
        Open Discord and make sure you're logged in:
        <a href="https://discord.com/app" target="_blank" rel="noopener"
           class="ml-1 inline-block px-3 py-1 bg-gray-800 hover:bg-gray-700 text-gray-200 rounded-md text-xs font-medium">
          Open discord.com →
        </a>
      </li>
      <li>
        On the Discord tab, click the bookmarklet. A toast will appear top-right; once it turns green, you're done.
        Click any channel if it stays "waiting" past 30s — that fires a request the bookmarklet can capture.
      </li>
    </ol>

    <div id="discord-connect-status" class="text-sm text-gray-400 bg-gray-950 border border-gray-800 rounded-md p-3 text-center">
      Waiting for credentials…
    </div>

    <details class="mt-3 text-xs text-gray-500">
      <summary class="cursor-pointer hover:text-gray-300">Show bookmarklet code (paste into a manual bookmark)</summary>
      <textarea id="discord-bookmarklet-code" readonly
                class="mt-2 w-full h-28 bg-gray-950 border border-gray-800 rounded-md p-2 font-mono text-[10px] text-gray-400 select-all"></textarea>
    </details>
  </div>
</div>

<!-- Subscribe-to-channel modal — sequential flow: platform → (workspace) → channel → mode -->
<div id="add-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4"
     onclick="if(event.target===this) closeAddModal()">
  <div class="bg-gray-900 border border-gray-700 rounded-xl p-6 max-w-lg w-full">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-lg font-semibold">Subscribe to a channel</h2>
        <p class="text-xs text-gray-500">Watch ONE channel. Connect platforms via the Connections panel above.</p>
      </div>
      <button onclick="closeAddModal()" class="text-gray-400 hover:text-white">✕</button>
    </div>

    <form id="add-form" class="space-y-4">
      <!-- Step 1: Platform -->
      <div>
        <label class="block text-xs uppercase text-gray-500 mb-1">1. Platform</label>
        <select id="platform-select" name="platform"
                class="w-full bg-gray-900 border border-gray-700 rounded-md px-3 py-2 text-sm"
                onchange="onPlatformChange()">
          <option value="discord" selected>Discord</option>
          <option value="slack">Slack</option>
        </select>
      </div>

      <!-- Step 2 (Slack only): Workspace -->
      <div id="step-workspace" class="hidden">
        <label class="block text-xs uppercase text-gray-500 mb-1">2. Slack workspace</label>
        <div id="no-workspaces" class="hidden p-3 rounded-md border border-yellow-700/50 bg-yellow-900/20 text-sm">
          <p class="text-yellow-200 mb-2">No Slack workspaces connected yet.</p>
          <a href="/oauth/slack/start"
             class="inline-block px-3 py-1 rounded-md text-xs font-medium bg-accent text-white hover:bg-accent/90 transition-colors">
            Connect a Slack workspace
          </a>
        </div>
        <select id="slack-workspace-select" name="account_id"
                class="w-full bg-gray-900 border border-gray-700 rounded-md px-3 py-2 text-sm"
                onchange="onWorkspaceChange()">
          <option value="">Select a workspace…</option>
        </select>
      </div>

      <!-- Step 2/3: Source type (Discord) or auto-set (Slack) -->
      <div id="step-source-type">
        <label class="block text-xs uppercase text-gray-500 mb-1"><span id="source-step-num">2</span>. Source</label>
        <select id="source-type" class="w-full bg-gray-900 border border-gray-700 rounded-md px-3 py-2 text-sm"
                onchange="loadSources()">
          <option value="dm">DM</option>
          <option value="guild">Guild channel</option>
        </select>
      </div>

      <div id="guild-picker" class="hidden">
        <label class="block text-xs uppercase text-gray-500 mb-1">Guild</label>
        <select id="guild-select" class="w-full bg-gray-900 border border-gray-700 rounded-md px-3 py-2 text-sm"
                onchange="loadGuildChannels()">
          <option value="">Loading…</option>
        </select>
      </div>

      <!-- Step 3/4: Channel -->
      <div id="step-channel" class="hidden">
        <label class="block text-xs uppercase text-gray-500 mb-1"><span id="channel-step-num">3</span>. Channel</label>
        <div id="channel-status" class="text-sm text-gray-500 mb-1 hidden"></div>
        <select id="channel-select" name="channel_id"
                class="w-full bg-gray-900 border border-gray-700 rounded-md px-3 py-2 text-sm"
                onchange="onChannelPick()">
          <option value="">—</option>
        </select>
        <input type="hidden" id="display-name-hidden" name="display_name" />
      </div>

      <!-- Step 4/5: Mode -->
      <div id="step-mode" class="hidden">
        <label class="block text-xs uppercase text-gray-500 mb-1"><span id="mode-step-num">4</span>. Mode</label>
        <select name="mode" class="w-full bg-gray-900 border border-gray-700 rounded-md px-3 py-2 text-sm">
          <option value="priority">priority — full triage + approval</option>
          <option value="digest" selected>digest — daily summary</option>
          <option value="store_only">store_only — raw persistence</option>
        </select>
      </div>

      <div id="add-error" class="hidden text-sm text-red-400"></div>

      <div class="flex gap-2 justify-end">
        <button type="button"
                onclick="closeAddModal()"
                class="px-3 py-1.5 rounded-md text-sm font-medium text-gray-400 hover:text-white hover:bg-gray-800">
          Cancel
        </button>
        <button id="submit-btn" type="submit" disabled
                class="px-3 py-1.5 rounded-md text-sm font-medium bg-accent text-white hover:bg-accent/90 disabled:opacity-40 disabled:cursor-not-allowed">
          Add
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Channel id → display label so we can stash a human-readable name on submit.
  const channelState = new Map();
  // Cached after the panel + modal load so we don't re-fetch unnecessarily.
  let slackWorkspaces = [];

  // --- discord status panel -----------------------------------------------
  let discordConnected = false;
  async function renderDiscordStatus() {
    const badge = document.getElementById('discord-status-badge');
    const body = document.getElementById('discord-status-body');
    const btn = document.getElementById('discord-connect-btn');
    try {
      const res = await fetch('/api/discord/status');
      const s = await res.json();
      discordConnected = !!s.connected;
      if (s.connected) {
        badge.textContent = 'connected';
        badge.className = 'text-xs px-2 py-0.5 rounded bg-green-900/50 text-green-300 border border-green-700/50';
        body.innerHTML = '<span class="text-gray-300">Logged in as user_id <code class="text-gray-400">' +
          escapeHtml(s.user_id || 'unknown') + '</code></span>';
        if (btn) btn.classList.add('hidden');
      } else {
        badge.textContent = 'not connected';
        badge.className = 'text-xs px-2 py-0.5 rounded bg-yellow-900/50 text-yellow-300 border border-yellow-700/50';
        body.innerHTML =
          '<p class="text-yellow-200 text-sm">Click <span class="text-gray-200 font-medium">Connect Discord</span> to grab your session via the bookmarklet — no terminal required.</p>';
        if (btn) btn.classList.remove('hidden');
      }
    } catch (e) {
      badge.textContent = 'error';
      badge.className = 'text-xs px-2 py-0.5 rounded bg-red-900/50 text-red-300 border border-red-700/50';
      body.innerHTML = '<p class="text-red-400">' + escapeHtml(e.message) + '</p>';
    }
  }

  // --- discord connect modal: bookmarklet + live status poll --------------
  // Bookmarklet runs on https://discord.com/*. It hooks fetch+XHR to capture
  // `authorization` and `x-super-properties` headers from any Discord-internal
  // request (heartbeat, channel switch, etc.), then POSTs four fields to our
  // /api/discord/creds endpoint. The dashboard server runs `augmentagent
  // discord login` to validate + persist to Keychain.
  const DISCORD_BOOKMARKLET = (function() {
    const src = '(function(){if(window.__aaDiscord)return;window.__aaDiscord=1;var ENDPOINT="' +
      window.location.origin + '/api/discord/creds";var MAX=60;var c={};var n=["authorization","x-super-properties"];' +
      'var box=document.createElement("div");box.style.cssText="position:fixed;top:20px;right:20px;background:#5865F2;color:#fff;padding:14px 18px;border-radius:8px;z-index:2147483647;font-family:system-ui,sans-serif;font-size:14px;max-width:340px;box-shadow:0 4px 14px rgba(0,0,0,.35);line-height:1.4";' +
      'box.innerHTML="<b>augmentagent</b> · capturing Discord credentials…<div id=\\"aa-msg\\" style=\\"margin-top:6px;font-size:12px;opacity:.85\\">Click any channel to fire a request faster.</div>";' +
      'document.body.appendChild(box);var msg=box.querySelector("#aa-msg");' +
      'var oX=XMLHttpRequest.prototype.setRequestHeader;XMLHttpRequest.prototype.setRequestHeader=function(k,v){var lk=(k||"").toLowerCase();if(n.indexOf(lk)>=0)c[lk]=v;return oX.apply(this,arguments)};' +
      'var oF=window.fetch;window.fetch=function(u,i){try{var h=i&&i.headers;if(h){if(h.get){n.forEach(function(k){var v=h.get(k);if(v)c[k]=v})}else if(Array.isArray(h)){h.forEach(function(p){var lk=(p[0]||"").toLowerCase();if(n.indexOf(lk)>=0)c[lk]=p[1]})}else if(typeof h==="object"){Object.keys(h).forEach(function(k){var lk=k.toLowerCase();if(n.indexOf(lk)>=0)c[lk]=h[k]})}}}catch(e){}return oF.apply(this,arguments)};' +
      'var t=0;var iv=setInterval(function(){t++;if(t>MAX){clearInterval(iv);box.style.background="#FAA61A";box.innerHTML="<b>augmentagent</b> · timed out. Click a channel and re-run the bookmarklet.";setTimeout(function(){box.remove()},8000);return}msg.textContent="Waiting ("+t+"s). Click any channel to fire a request faster.";' +
      'if(c["authorization"]&&c["x-super-properties"]){clearInterval(iv);(async function(){try{var ur=await oF("/api/v9/users/@me",{credentials:"include",headers:{authorization:c["authorization"]}});var u=await ur.json();var p={user_id:u.id,token:c["authorization"],super_properties_b64:c["x-super-properties"],user_agent:navigator.userAgent};var r=await oF(ENDPOINT,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(p),mode:"cors"});if(!r.ok){var et=await r.text();throw new Error("HTTP "+r.status+": "+et)}box.style.background="#3BA55D";box.innerHTML="<b>augmentagent</b> · ✅ connected. You can close this tab.";setTimeout(function(){box.remove()},6000)}catch(e){box.style.background="#ED4245";box.innerHTML="<b>augmentagent</b> · ❌ "+(e.message||e);setTimeout(function(){box.remove()},12000)}})()}},1000)})();';
    return 'javascript:' + encodeURIComponent(src);
  })();

  let discordConnectPoller = null;
  function openDiscordConnectModal() {
    const modal = document.getElementById('discord-connect-modal');
    const link = document.getElementById('discord-bookmarklet-link');
    const code = document.getElementById('discord-bookmarklet-code');
    const status = document.getElementById('discord-connect-status');
    if (link) link.setAttribute('href', DISCORD_BOOKMARKLET);
    if (code) code.value = DISCORD_BOOKMARKLET;
    if (status) {
      status.className = 'text-sm text-gray-400 bg-gray-950 border border-gray-800 rounded-md p-3 text-center';
      status.textContent = 'Waiting for credentials…';
    }
    modal.classList.remove('hidden');
    // Poll status every 2s; auto-close on success.
    discordConnectPoller = setInterval(async () => {
      try {
        const res = await fetch('/api/discord/status');
        const s = await res.json();
        if (s.connected) {
          if (status) {
            status.className = 'text-sm text-green-300 bg-green-900/30 border border-green-700/50 rounded-md p-3 text-center';
            status.innerHTML = '✅ Connected as <code class="text-green-200">' + escapeHtml(s.user_id || 'unknown') + '</code>. Closing in a moment…';
          }
          clearInterval(discordConnectPoller);
          discordConnectPoller = null;
          setTimeout(() => {
            closeDiscordConnectModal();
            renderDiscordStatus();
          }, 1500);
        }
      } catch (_) { /* keep polling */ }
    }, 2000);
  }

  function closeDiscordConnectModal() {
    document.getElementById('discord-connect-modal').classList.add('hidden');
    if (discordConnectPoller) {
      clearInterval(discordConnectPoller);
      discordConnectPoller = null;
    }
  }

  // --- workspace panel ----------------------------------------------------
  async function renderSlackWorkspaces() {
    const target = document.getElementById('slack-workspaces-list');
    try {
      const res = await fetch('/api/slack/workspaces');
      slackWorkspaces = await res.json();
      if (!slackWorkspaces.length) {
        target.innerHTML = '<p class="text-gray-500 italic">No workspaces connected yet. Click <span class="font-medium">Connect workspace</span> above.</p>';
      } else {
        target.innerHTML = slackWorkspaces
          .map((w) =>
            '<div class="flex items-center justify-between py-1.5 gap-2">' +
              '<span class="min-w-0 truncate">' +
                '<span class="font-medium text-white">' + escapeHtml(w.team_name) + '</span>' +
                ' <span class="text-gray-500">(' + escapeHtml(w.team_id) + ')</span>' +
              '</span>' +
              '<span class="flex gap-2 shrink-0">' +
                '<button onclick="openChannelManager(\'' + escapeJs(w.team_id) + '\',\'' + escapeJs(w.team_name) + '\')" ' +
                  'class="text-xs px-2 py-0.5 rounded bg-accent text-white hover:bg-accent/90">Manage channels</button>' +
                '<button onclick="removeWorkspace(\'' + escapeJs(w.team_id) + '\')" ' +
                  'class="text-xs text-red-400 hover:text-red-300">Disconnect</button>' +
              '</span>' +
            '</div>'
          )
          .join('');
      }
      populateSlackWorkspaceSelect();
    } catch (e) {
      target.innerHTML = '<p class="text-red-400">Failed to load workspaces: ' + escapeHtml(e.message) + '</p>';
    }
  }

  function escapeHtml(s) {
    return String(s || '')
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function escapeJs(s) {
    return String(s || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");
  }

  async function removeWorkspace(teamId) {
    if (!confirm('Disconnect workspace ' + teamId + '? Subscriptions on this workspace stop polling.')) return;
    const res = await fetch('/api/slack/workspaces/' + encodeURIComponent(teamId), { method: 'DELETE' });
    if (res.ok) { renderSlackWorkspaces(); }
    else { alert('Failed to disconnect workspace'); }
  }

  function populateSlackWorkspaceSelect() {
    const sel = document.getElementById('slack-workspace-select');
    if (!sel) return;
    sel.innerHTML =
      '<option value="">Select a workspace…</option>' +
      slackWorkspaces
        .map((w) => '<option value="' + escapeHtml(w.team_id) + '">' + escapeHtml(w.team_name) + '</option>')
        .join('');
  }

  // --- modal lifecycle ----------------------------------------------------
  function openAddModal() {
    document.getElementById('add-modal').classList.remove('hidden');
    onPlatformChange(); // Reset state to current platform's flow.
  }

  function closeAddModal() {
    document.getElementById('add-modal').classList.add('hidden');
    document.getElementById('add-form').reset();
    document.getElementById('add-error').classList.add('hidden');
    document.getElementById('submit-btn').disabled = true;
  }

  // --- step orchestration -------------------------------------------------
  function showStep(id, on) {
    document.getElementById(id).classList.toggle('hidden', !on);
  }

  function setSubmitEnabled() {
    const channel = document.getElementById('channel-select').value;
    const platform = document.getElementById('platform-select').value;
    let ready = !!channel;
    if (platform === 'slack') {
      const ws = document.getElementById('slack-workspace-select').value;
      ready = ready && !!ws;
    }
    document.getElementById('submit-btn').disabled = !ready;
  }

  function onPlatformChange() {
    const platform = document.getElementById('platform-select').value;
    const srcSel = document.getElementById('source-type');
    document.getElementById('add-error').classList.add('hidden');

    if (platform === 'slack') {
      // Step 2 = workspace (Slack-only).
      showStep('step-workspace', true);
      document.getElementById('source-step-num').textContent = '3';
      document.getElementById('channel-step-num').textContent = '4';
      document.getElementById('mode-step-num').textContent = '5';

      srcSel.innerHTML = [
        '<option value="slack_dm">DMs / group DMs</option>',
        '<option value="slack_channel">Public / private channels</option>',
      ].join('');

      const hasWs = slackWorkspaces.length > 0;
      showStep('no-workspaces', !hasWs);
      document.getElementById('slack-workspace-select').classList.toggle('hidden', !hasWs);
      // Defer source/channel/mode until a workspace is picked.
      showStep('step-source-type', false);
      showStep('step-channel', false);
      showStep('step-mode', false);
      showStep('guild-picker', false);
    } else {
      // Discord: workspace step skipped, but still gate on connection status.
      showStep('step-workspace', false);
      document.getElementById('source-step-num').textContent = '2';
      document.getElementById('channel-step-num').textContent = '3';
      document.getElementById('mode-step-num').textContent = '4';

      srcSel.innerHTML = [
        '<option value="dm">DM</option>',
        '<option value="guild">Guild channel</option>',
      ].join('');
      if (!discordConnected) {
        showStep('step-source-type', false);
        showStep('step-channel', false);
        showStep('step-mode', false);
        const err = document.getElementById('add-error');
        err.textContent = 'Discord is not connected yet — see the Connections panel above.';
        err.classList.remove('hidden');
      } else {
        showStep('step-source-type', true);
        showStep('step-channel', true);
        showStep('step-mode', true);
        loadSources();
      }
    }
    setSubmitEnabled();
  }

  function onWorkspaceChange() {
    const ws = document.getElementById('slack-workspace-select').value;
    if (!ws) {
      showStep('step-source-type', false);
      showStep('step-channel', false);
      showStep('step-mode', false);
      setSubmitEnabled();
      return;
    }
    // Workspace selected — reveal source-type → channel → mode.
    showStep('step-source-type', true);
    showStep('step-channel', true);
    showStep('step-mode', true);
    loadSources();
  }

  // --- channel loading ----------------------------------------------------
  async function loadSources() {
    const platform = document.getElementById('platform-select').value;
    const type = document.getElementById('source-type').value;
    const guildPicker = document.getElementById('guild-picker');
    const channelSel = document.getElementById('channel-select');
    const status = document.getElementById('channel-status');

    channelSel.innerHTML = '<option value="">—</option>';
    guildPicker.classList.add('hidden');
    status.classList.remove('hidden');
    status.textContent = 'Loading channels…';
    status.className = 'text-sm text-gray-400 mb-1';
    setSubmitEnabled();

    try {
      if (platform === 'discord' && type === 'dm') {
        const res = await fetch('/api/discord/dms');
        if (!res.ok) throw new Error(await res.text());
        const dms = await res.json();
        channelState.clear();
        channelSel.innerHTML = '<option value="">Select a DM…</option>' +
          dms.map((d) => {
            const label = 'DM: ' + d.display_name;
            channelState.set(d.id, label);
            return '<option value="' + escapeHtml(d.id) + '">' + escapeHtml(label) + '</option>';
          }).join('');
        status.classList.add('hidden');
      } else if (platform === 'discord' && type === 'guild') {
        guildPicker.classList.remove('hidden');
        const res = await fetch('/api/discord/guilds');
        if (!res.ok) throw new Error(await res.text());
        const guilds = await res.json();
        const gSel = document.getElementById('guild-select');
        gSel.innerHTML = guilds
          .map((g) => '<option value="' + escapeHtml(g.id) + '" data-name="' + escapeHtml(g.name) + '">' + escapeHtml(g.name) + '</option>')
          .join('');
        await loadGuildChannels();
        status.classList.add('hidden');
      } else if (platform === 'slack') {
        const teamId = document.getElementById('slack-workspace-select').value;
        if (!teamId) {
          status.textContent = 'Pick a workspace first.';
          return;
        }
        const slackTypes = type === 'slack_dm' ? 'im,mpim' : 'public_channel,private_channel';
        const res = await fetch('/api/slack/conversations?types=' + encodeURIComponent(slackTypes) + '&team_id=' + encodeURIComponent(teamId));
        if (res.status === 409) {
          // Orphan workspace cleaned up server-side. Refresh the panel and
          // tell the user to re-OAuth.
          const body = await res.json();
          status.innerHTML = body.error +
            ' <a href="/oauth/slack/start" class="text-accent underline">Connect workspace</a>';
          status.className = 'text-sm text-yellow-300 mb-1';
          await renderSlackWorkspaces();
          return;
        }
        if (!res.ok) {
          const body = await res.text();
          throw new Error('Slack list failed: ' + body);
        }
        const convs = await res.json();
        channelState.clear();
        if (!convs.length) {
          status.textContent = 'No ' + (type === 'slack_dm' ? 'DMs' : 'channels') + ' visible to this workspace.';
        } else {
          status.classList.add('hidden');
        }
        channelSel.innerHTML = '<option value="">Select a channel…</option>' +
          convs.map((c) => {
            channelState.set(c.id, c.display_name);
            return '<option value="' + escapeHtml(c.id) + '">' + escapeHtml(c.display_name) + '</option>';
          }).join('');
      }
    } catch (e) {
      status.textContent = 'Error: ' + e.message;
      status.className = 'text-sm text-red-400 mb-1';
    } finally {
      setSubmitEnabled();
    }
  }

  async function loadGuildChannels() {
    const gSel = document.getElementById('guild-select');
    const guildId = gSel.value;
    const guildName = gSel.selectedOptions[0]?.dataset?.name || 'guild';
    const channelSel = document.getElementById('channel-select');
    if (!guildId) {
      channelSel.innerHTML = '<option value="">(pick a guild)</option>';
      return;
    }
    channelSel.innerHTML = '<option value="">Loading…</option>';
    try {
      const res = await fetch('/api/discord/guilds/' + guildId + '/channels');
      const channels = await res.json();
      channelState.clear();
      channelSel.innerHTML = '<option value="">Select a channel…</option>' +
        channels.map((c) => {
          const label = '#' + c.name + ' in ' + guildName;
          channelState.set(c.id, label);
          return '<option value="' + escapeHtml(c.id) + '">' + escapeHtml(label) + '</option>';
        }).join('');
    } catch (e) {
      channelSel.innerHTML = '<option>(error)</option>';
    } finally {
      setSubmitEnabled();
    }
  }

  function onChannelPick() {
    const sel = document.getElementById('channel-select');
    const label = channelState.get(sel.value) || sel.value;
    document.getElementById('display-name-hidden').value = label;
    setSubmitEnabled();
  }

  // --- submit -------------------------------------------------------------
  document.getElementById('add-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const err = document.getElementById('add-error');
    err.classList.add('hidden');
    const body = {
      platform: form.platform.value,
      channel_id: form.channel_id.value,
      display_name: form.display_name.value,
      mode: form.mode.value,
    };
    if (form.platform.value === 'slack') {
      body.account_id = document.getElementById('slack-workspace-select').value;
    }
    if (!body.channel_id || !body.display_name) {
      err.textContent = 'Pick a channel before submitting.';
      err.classList.remove('hidden');
      return;
    }
    const res = await fetch('/api/subscriptions', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });
    if (!res.ok) {
      err.textContent = await res.text();
      err.classList.remove('hidden');
      return;
    }
    const html = await res.text();
    document.getElementById('sub-table-body').innerHTML = html;
    closeAddModal();
  });

  // ==========================================================================
  // Channel manager (bulk select with checkboxes)
  // ==========================================================================
  let cmTeamId = null;
  let cmChannels = []; // { id, display_name, is_im, is_mpim, is_private, subscribed, mode }
  let cmChecked = new Set();

  async function openChannelManager(teamId, teamName) {
    cmTeamId = teamId;
    cmChannels = [];
    cmChecked = new Set();
    document.getElementById('cm-workspace-name').textContent = teamName;
    document.getElementById('cm-error').classList.add('hidden');
    document.getElementById('cm-list').innerHTML =
      '<div class="p-4 text-center text-sm text-gray-400">Loading channels…</div>';
    document.getElementById('channels-modal').classList.remove('hidden');
    document.getElementById('cm-search').value = '';
    document.getElementById('cm-filter').value = 'all';

    try {
      const res = await fetch('/api/slack/workspaces/' + encodeURIComponent(teamId) + '/channels');
      if (res.status === 409) {
        const body = await res.json();
        const err = document.getElementById('cm-error');
        err.innerHTML = body.error +
          ' <a href="/oauth/slack/start" class="text-accent underline">Reconnect</a>';
        err.classList.remove('hidden');
        document.getElementById('cm-list').innerHTML = '';
        await renderSlackWorkspaces();
        return;
      }
      if (!res.ok) {
        const errBody = await res.text();
        throw new Error(errBody);
      }
      cmChannels = await res.json();
      // Pre-check anything already subscribed.
      for (const c of cmChannels) {
        if (c.subscribed) cmChecked.add(c.id);
      }
      renderCmList();
    } catch (e) {
      document.getElementById('cm-list').innerHTML = '';
      const err = document.getElementById('cm-error');
      err.textContent = 'Failed to load channels: ' + (e.message || e);
      err.classList.remove('hidden');
    }
  }

  function closeChannelManager() {
    document.getElementById('channels-modal').classList.add('hidden');
    cmTeamId = null;
    cmChannels = [];
    cmChecked = new Set();
  }

  function visibleChannels() {
    const filter = document.getElementById('cm-filter').value;
    const q = (document.getElementById('cm-search').value || '').toLowerCase().trim();
    return cmChannels.filter((c) => {
      if (filter === 'dms' && !(c.is_im || c.is_mpim)) return false;
      if (filter === 'channels' && (c.is_im || c.is_mpim)) return false;
      if (filter === 'subscribed' && !cmChecked.has(c.id)) return false;
      if (q && !(c.display_name || '').toLowerCase().includes(q)) return false;
      return true;
    });
  }

  function renderCmList() {
    const list = document.getElementById('cm-list');
    const visible = visibleChannels();
    if (!cmChannels.length) {
      list.innerHTML = '<div class="p-4 text-center text-sm text-gray-400">No channels visible to this workspace.</div>';
    } else if (!visible.length) {
      list.innerHTML = '<div class="p-4 text-center text-sm text-gray-400">No channels match your filter.</div>';
    } else {
      list.innerHTML = visible
        .map((c) => {
          const checked = cmChecked.has(c.id) ? 'checked' : '';
          const kind = c.is_im ? 'DM' : c.is_mpim ? 'GROUP' : c.is_private ? 'PRIV' : 'CH';
          const modeBadge = c.subscribed
            ? '<span class="text-xs px-1.5 py-0.5 rounded bg-green-900/50 text-green-300 border border-green-700/50">' + escapeHtml(c.mode || 'sub') + '</span>'
            : '';
          return (
            '<label class="flex items-center gap-3 px-3 py-2 hover:bg-gray-900 cursor-pointer">' +
              '<input type="checkbox" data-id="' + escapeHtml(c.id) + '" ' + checked +
                ' onchange="cmToggle(\'' + escapeJs(c.id) + '\', this.checked)" ' +
                ' class="rounded border-gray-700 bg-gray-900 text-accent focus:ring-accent" />' +
              '<span class="text-xs text-gray-500 font-mono w-12 shrink-0">' + kind + '</span>' +
              '<span class="text-sm text-gray-200 flex-1 truncate">' + escapeHtml(c.display_name) + '</span>' +
              modeBadge +
            '</label>'
          );
        })
        .join('');
    }
    document.getElementById('cm-count').textContent =
      cmChecked.size + ' selected · ' + visible.length + ' shown · ' + cmChannels.length + ' total';
  }

  function cmToggle(id, on) {
    if (on) cmChecked.add(id); else cmChecked.delete(id);
    renderCmList();
  }

  function cmSelectAll(on) {
    for (const c of visibleChannels()) {
      if (on) cmChecked.add(c.id); else cmChecked.delete(c.id);
    }
    renderCmList();
  }

  async function cmApply(replace) {
    if (!cmTeamId) return;
    const mode = document.getElementById('cm-mode').value;
    const channels = cmChannels
      .filter((c) => cmChecked.has(c.id))
      .map((c) => ({ id: c.id, display_name: c.display_name }));
    const err = document.getElementById('cm-error');
    err.classList.add('hidden');
    if (!channels.length && !replace) {
      err.textContent = 'Select at least one channel.';
      err.classList.remove('hidden');
      return;
    }
    const res = await fetch('/api/slack/workspaces/' + encodeURIComponent(cmTeamId) + '/subscribe', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ mode, channels, replace }),
    });
    if (!res.ok) {
      err.textContent = 'Subscribe failed: ' + (await res.text());
      err.classList.remove('hidden');
      return;
    }
    const html = await res.text();
    document.getElementById('sub-table-body').innerHTML = html;
    closeChannelManager();
  }

  // Boot: load both connection panels in parallel. Modal stays closed; opening
  // it triggers onPlatformChange() to set up the right step sequence based on
  // current connection state.
  renderSlackWorkspaces();
  renderDiscordStatus();
</script>

