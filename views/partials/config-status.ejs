<div class="space-y-3">
  <div class="flex items-center justify-between py-2">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full <%= configStatus.cerebrasKey ? 'bg-green-400' : 'bg-gray-600' %>"></span>
      <span class="text-sm">Cerebras (LLM - Primary)</span>
    </div>
    <span class="text-xs text-gray-500"><%= configStatus.cerebrasKey ? 'Connected' : 'Not configured' %></span>
  </div>
  <div class="flex items-center justify-between py-2">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full <%= configStatus.groqKey ? 'bg-green-400' : 'bg-gray-600' %>"></span>
      <span class="text-sm">Groq (LLM - Fallback)</span>
    </div>
    <span class="text-xs text-gray-500"><%= configStatus.groqKey ? 'Connected' : 'Not configured' %></span>
  </div>
  <div class="flex items-center justify-between py-2">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full <%= configStatus.composioKey ? 'bg-green-400' : 'bg-gray-600' %>"></span>
      <span class="text-sm">Composio (API Key)</span>
    </div>
    <span class="text-xs text-gray-500"><%= configStatus.composioKey ? 'Connected' : 'Not configured' %></span>
  </div>

  <!-- Gmail Accounts (multiple) -->
  <div class="py-2">
    <div class="flex items-center justify-between mb-2">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full <%= configStatus.gmailConnected ? 'bg-green-400' : 'bg-gray-600' %>"></span>
        <span class="text-sm">Gmail (<%= configStatus.gmailAccounts.length %> account<%= configStatus.gmailAccounts.length !== 1 ? 's' : '' %>)</span>
      </div>
      <% if (configStatus.composioKey) { %>
        <a href="/oauth/gmail/start"
           class="px-3 py-1 bg-blue-600 hover:bg-blue-500 rounded text-xs font-medium transition-colors">
          + Add Gmail
        </a>
      <% } else { %>
        <span class="text-xs text-gray-500">Add Composio key first</span>
      <% } %>
    </div>
    <% if (configStatus.gmailAccounts.length > 0) { %>
      <div class="ml-4 space-y-1">
        <% configStatus.gmailAccounts.forEach(function(account) { %>
          <div class="flex items-center justify-between py-1 group">
            <div class="flex items-center gap-2 min-w-0">
              <span class="w-1.5 h-1.5 rounded-full <%= account.active ? 'bg-green-400' : 'bg-gray-600' %>"></span>
              <span class="text-xs <%= account.active ? 'text-gray-300' : 'text-gray-500' %>">
                <%= account.email || account.label || account.connectionId.slice(0, 12) + '...' %>
              </span>
              <code class="text-[10px] text-gray-600 truncate" title="Composio entity — use with: !invoice entity &lt;id&gt;"><%= account.entityId %></code>
            </div>
            <button
              hx-delete="/api/oauth/gmail/<%= account.id %>"
              hx-target="#config-status"
              hx-swap="innerHTML"
              hx-confirm="Remove this Gmail account?"
              class="text-xs text-gray-600 hover:text-red-400 opacity-0 group-hover:opacity-100 transition-opacity">
              Remove
            </button>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <div class="flex items-center justify-between py-2">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full <%= configStatus.discordWebhook ? 'bg-green-400' : 'bg-gray-600' %>"></span>
      <span class="text-sm">Discord Webhook</span>
    </div>
    <span class="text-xs text-gray-500"><%= configStatus.discordWebhook ? 'Connected' : 'Not configured' %></span>
  </div>
  <div class="flex items-center justify-between py-2">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full <%= configStatus.discordBotToken ? 'bg-green-400' : 'bg-gray-600' %>"></span>
      <span class="text-sm">Discord Bot (optional)</span>
    </div>
    <span class="text-xs text-gray-500"><%= configStatus.discordBotToken ? 'Connected' : 'Not configured' %></span>
  </div>
</div>
