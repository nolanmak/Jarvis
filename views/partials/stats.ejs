<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
  <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
    <p class="text-xs text-gray-500 uppercase tracking-wide">Total Processed</p>
    <p class="text-2xl font-bold mt-1"><%= stats.total %></p>
  </div>
  <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
    <p class="text-xs text-gray-500 uppercase tracking-wide">Today</p>
    <p class="text-2xl font-bold mt-1"><%= stats.todayCount %></p>
  </div>
  <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
    <p class="text-xs text-gray-500 uppercase tracking-wide">Approval Rate</p>
    <p class="text-2xl font-bold mt-1 <%= stats.approvalRate >= 70 ? 'text-green-400' : stats.approvalRate >= 40 ? 'text-yellow-400' : 'text-red-400' %>">
      <%= stats.approvalRate %>%
    </p>
  </div>
  <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
    <div class="flex gap-4">
      <div>
        <p class="text-xs text-gray-500">Sent</p>
        <p class="text-lg font-semibold text-green-400"><%= stats.sent %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500">Rejected</p>
        <p class="text-lg font-semibold text-red-400"><%= stats.rejected %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500">Errors</p>
        <p class="text-lg font-semibold text-yellow-400"><%= stats.errored %></p>
      </div>
    </div>
  </div>
</div>
