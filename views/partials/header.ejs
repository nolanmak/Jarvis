<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AugmentAgent</title>
  <!-- Self-hosted Tailwind (replaces the in-browser Play CDN that was failing
       to load behind some networks/ad-blockers, leaving the dashboard
       unstyled). Built from tailwind.input.css + tailwind.config.js via
       `npm run tailwind:build`; served by express.static from /public. -->
  <link rel="stylesheet" href="/tailwind.css" />
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
</head>
<body class="bg-gray-950 text-gray-100 min-h-screen">
  <nav class="border-b border-gray-800 bg-gray-900/80 backdrop-blur sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 flex items-center h-14 gap-8">
      <a href="/dashboard" class="text-lg font-semibold tracking-tight text-white">
        AugmentAgent
      </a>
      <div class="flex gap-1">
        <a href="/dashboard"
           class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors
                  <%= page === 'dashboard' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800/50' %>">
          Dashboard
        </a>
        <a href="/history"
           class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors
                  <%= page === 'history' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800/50' %>">
          History
        </a>
        <a href="/subscriptions"
           class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors
                  <%= page === 'subscriptions' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800/50' %>">
          Subscriptions
        </a>
        <a href="/settings"
           class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors
                  <%= page === 'settings' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800/50' %>">
          Settings
        </a>
        <a href="/relationships"
           class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors
                  <%= page === 'relationships' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800/50' %>">
          Relationships
        </a>
        <a href="/repos"
           class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors
                  <%= page === 'repos' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800/50' %>">
          Repos
        </a>
        <a href="/sessions"
           class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors
                  <%= page === 'sessions' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800/50' %>">
          Sessions
        </a>
        <a href="/audit"
           class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors
                  <%= page === 'audit' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800/50' %>">
          Activity
        </a>
        <a href="/resume"
           class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors
                  <%= page === 'resume' ? 'bg-gray-800 text-white' : 'text-gray-400 hover:text-white hover:bg-gray-800/50' %>">
          Resume
        </a>
        <% if (typeof kbUrl !== 'undefined' && kbUrl) { %>
        <a href="<%= kbUrl %>" target="_blank" rel="noopener"
           class="px-3 py-1.5 rounded-md text-sm font-medium text-gray-400 hover:text-white hover:bg-gray-800/50 transition-colors">
          Knowledge base &#8599;
        </a>
        <% } %>
      </div>
      <div class="ml-auto">
        <span class="text-xs text-gray-500">v1.0.0</span>
      </div>
    </div>
  </nav>
  <main class="max-w-6xl mx-auto px-4 py-6">
