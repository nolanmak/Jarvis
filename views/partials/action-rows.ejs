<% if (actions.length === 0) { %>
  <tr>
    <td colspan="6" class="px-4 py-8 text-center text-gray-500">
      No actions found. The agent will populate this as it processes emails.
    </td>
  </tr>
<% } else { %>
  <% actions.forEach(function(action) { %>
    <tr class="border-b border-gray-800 hover:bg-gray-800/50 cursor-pointer"
        hx-get="/api/actions/<%= action.id %>/preview"
        hx-target="#preview-modal-content"
        hx-swap="innerHTML"
        onclick="document.getElementById('preview-modal').classList.remove('hidden')">
      <td class="px-4 py-3 text-sm text-gray-400">
        <%= new Date(action.createdAt).toLocaleString() %>
      </td>
      <td class="px-4 py-3 text-xs text-gray-400 uppercase"><%= action.platform || 'gmail' %></td>
      <td class="px-4 py-3 text-sm"><%= action.fromEmail %></td>
      <td class="px-4 py-3 text-sm font-medium"><%= action.subject %></td>
      <td class="px-4 py-3">
        <% if (action.status === 'sent' || action.status === 'approved') { %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-900/50 text-green-400 border border-green-800">
            <%= action.status %>
          </span>
        <% } else if (action.status === 'rejected') { %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-900/50 text-red-400 border border-red-800">
            rejected
          </span>
        <% } else if (action.status === 'error') { %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-900/50 text-yellow-400 border border-yellow-800">
            error
          </span>
        <% } else if (action.status === 'pending') { %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-900/50 text-blue-400 border border-blue-800">
            pending
          </span>
        <% } else { %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-800 text-gray-400 border border-gray-700">
            <%= action.status %>
          </span>
        <% } %>
      </td>
      <td class="px-4 py-3 text-sm text-gray-500">
        <% if (action.errorMessage) { %>
          <span title="<%= action.errorMessage %>">View</span>
        <% } %>
      </td>
    </tr>
  <% }); %>
<% } %>

<% if (totalPages > 1) { %>
  <tr>
    <td colspan="6" class="px-4 py-3">
      <div class="flex items-center justify-between">
        <span class="text-sm text-gray-500">
          Page <%= currentPage %> of <%= totalPages %>
        </span>
        <div class="flex gap-2">
          <% if (currentPage > 1) { %>
            <button
              hx-get="/api/actions?page=<%= currentPage - 1 %>&status=<%= currentStatus %>"
              hx-target="#action-table-body"
              hx-swap="innerHTML"
              class="px-3 py-1 text-sm bg-gray-800 rounded hover:bg-gray-700 transition-colors">
              Prev
            </button>
          <% } %>
          <% if (currentPage < totalPages) { %>
            <button
              hx-get="/api/actions?page=<%= currentPage + 1 %>&status=<%= currentStatus %>"
              hx-target="#action-table-body"
              hx-swap="innerHTML"
              class="px-3 py-1 text-sm bg-gray-800 rounded hover:bg-gray-700 transition-colors">
              Next
            </button>
          <% } %>
        </div>
      </div>
    </td>
  </tr>
<% } %>
