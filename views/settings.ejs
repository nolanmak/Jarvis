<%- include('partials/header', { page: 'settings' }) %>

<div class="space-y-8">
  <h1 class="text-xl font-semibold">Settings</h1>

  <!-- Integration Status -->
  <div class="bg-gray-900 border border-gray-800 rounded-lg p-6">
    <h2 class="text-sm font-medium text-gray-400 uppercase tracking-wide mb-4">Integrations</h2>
    <div id="config-status">
      <%- include('partials/config-status', { configStatus: configStatus }) %>
    </div>
  </div>

  <!-- Email Storage -->
  <div class="bg-gray-900 border border-gray-800 rounded-lg p-6">
    <h2 class="text-sm font-medium text-gray-400 uppercase tracking-wide mb-4">Email Storage</h2>
    <p class="text-xs text-gray-500 mb-4">
      Emails are stored locally for deduplication, analytics, and AI training data.
      <span class="text-gray-300 font-medium"><%= emailCount %></span> email(s) in archive.
    </p>

    <form hx-post="/api/config" hx-target="#config-status" hx-swap="innerHTML" class="flex gap-3 items-end">
      <input type="hidden" name="key" value="email_retention_days" />
      <div class="flex-1">
        <label class="block text-sm text-gray-400 mb-1">Retention Policy</label>
        <select name="value"
                class="w-full bg-gray-800 border border-gray-700 rounded-md px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500">
          <option value="0" <%= emailRetention === '0' ? 'selected' : '' %>>Keep forever (recommended)</option>
          <option value="30" <%= emailRetention === '30' ? 'selected' : '' %>>30 days</option>
          <option value="90" <%= emailRetention === '90' ? 'selected' : '' %>>90 days</option>
          <option value="180" <%= emailRetention === '180' ? 'selected' : '' %>>180 days</option>
          <option value="365" <%= emailRetention === '365' ? 'selected' : '' %>>1 year</option>
        </select>
      </div>
      <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded-md text-sm font-medium transition-colors">
        Save
      </button>
    </form>
    <p class="text-xs text-gray-600 mt-2">
      "Keep forever" stores all emails indefinitely. Other options auto-purge processed emails older than the selected period. Unprocessed emails are never deleted.
    </p>
  </div>

  <!-- Invoice Automation -->
  <div class="bg-gray-900 border border-gray-800 rounded-lg p-6">
    <h2 class="text-sm font-medium text-gray-400 uppercase tracking-wide mb-4">Invoice Automation</h2>
    <p class="text-xs text-gray-500 mb-4">
      Generates and emails the weekly Orchid invoice PDF every Sunday at 9am.
      <span class="text-amber-500 font-medium">Off by default</span> — turn it on
      only after the recipient and the sending Gmail account are set. The first
      automated draft is invoice #35 for the week ending 2026-05-24.
    </p>

    <div id="invoice-config" class="mb-4">
      <%- include('partials/invoice-config', { invoice: invoice }) %>
    </div>

    <form hx-post="/api/invoice-config" hx-target="#invoice-config" hx-swap="innerHTML"
          class="flex gap-3 items-end mb-3">
      <input type="hidden" name="key" value="auto_draft_enabled" />
      <div class="flex-1">
        <label class="block text-sm text-gray-400 mb-1">Automatic Sunday draft</label>
        <select name="value"
                class="w-full bg-gray-800 border border-gray-700 rounded-md px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500">
          <option value="false" <%= invoice.autoDraftEnabled ? '' : 'selected' %>>Off — do not post drafts (default)</option>
          <option value="true" <%= invoice.autoDraftEnabled ? 'selected' : '' %>>On — post draft for approval every Sunday</option>
        </select>
      </div>
      <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded-md text-sm font-medium transition-colors">
        Save
      </button>
    </form>

    <form hx-post="/api/invoice-config" hx-target="#invoice-config" hx-swap="innerHTML"
          class="flex gap-3 items-end">
      <input type="hidden" name="key" value="recipient_email" />
      <div class="flex-1">
        <label class="block text-sm text-gray-400 mb-1">Recipient email</label>
        <input type="email" name="value" value="<%= invoice.recipientEmail %>"
               placeholder="billing@example.com"
               class="w-full bg-gray-800 border border-gray-700 rounded-md px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
      </div>
      <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded-md text-sm font-medium transition-colors">
        Save
      </button>
    </form>
    <p class="text-xs text-gray-600 mt-2">
      The sending Gmail account (Composio entity) is set over Discord with
      <code class="text-gray-400">!invoice entity &lt;id&gt;</code>. Until the
      Sunday draft is On, the scheduler ticks but posts nothing. When On, the
      scheduler posts a draft PDF to Discord and waits for a human Approve
      click before any email is sent.
    </p>
  </div>

  <!-- API Keys -->
  <div class="bg-gray-900 border border-gray-800 rounded-lg p-6">
    <h2 class="text-sm font-medium text-gray-400 uppercase tracking-wide mb-4">API Configuration</h2>
    <div class="space-y-4">
      <!-- Cerebras (Primary) -->
      <form hx-post="/api/config" hx-target="#config-status" hx-swap="innerHTML" class="flex gap-3 items-end">
        <input type="hidden" name="key" value="cerebras_api_key" />
        <div class="flex-1">
          <label class="block text-sm text-gray-400 mb-1">Cerebras API Key <span class="text-gray-600">(primary)</span></label>
          <input type="password" name="value" placeholder="csk-..."
                 class="w-full bg-gray-800 border border-gray-700 rounded-md px-3 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500" />
        </div>
        <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded-md text-sm font-medium transition-colors">
          Save
        </button>
      </form>

      <!-- Groq (Fallback) -->
      <form hx-post="/api/config" hx-target="#config-status" hx-swap="innerHTML" class="flex gap-3 items-end">
        <input type="hidden" name="key" value="groq_api_key" />
        <div class="flex-1">
          <label class="block text-sm text-gray-400 mb-1">Groq API Key <span class="text-gray-600">(fallback)</span></label>
          <input type="password" name="value" placeholder="gsk_..."
                 class="w-full bg-gray-800 border border-gray-700 rounded-md px-3 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500" />
        </div>
        <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded-md text-sm font-medium transition-colors">
          Save
        </button>
      </form>

      <!-- Composio -->
      <form hx-post="/api/config" hx-target="#config-status" hx-swap="innerHTML" class="flex gap-3 items-end">
        <input type="hidden" name="key" value="composio_api_key" />
        <div class="flex-1">
          <label class="block text-sm text-gray-400 mb-1">Composio API Key</label>
          <input type="password" name="value" placeholder="ak_..."
                 class="w-full bg-gray-800 border border-gray-700 rounded-md px-3 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500" />
        </div>
        <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded-md text-sm font-medium transition-colors">
          Save
        </button>
      </form>

      <!-- Discord Webhook -->
      <form hx-post="/api/config" hx-target="#config-status" hx-swap="innerHTML" class="flex gap-3 items-end">
        <input type="hidden" name="key" value="discord_webhook_url" />
        <div class="flex-1">
          <label class="block text-sm text-gray-400 mb-1">Discord Webhook URL</label>
          <input type="password" name="value" placeholder="https://discord.com/api/webhooks/..."
                 class="w-full bg-gray-800 border border-gray-700 rounded-md px-3 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500" />
        </div>
        <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded-md text-sm font-medium transition-colors">
          Save
        </button>
      </form>

      <!-- Discord Bot Token (Optional) -->
      <form hx-post="/api/config" hx-target="#config-status" hx-swap="innerHTML" class="flex gap-3 items-end">
        <input type="hidden" name="key" value="discord_bot_token" />
        <div class="flex-1">
          <label class="block text-sm text-gray-400 mb-1">Discord Bot Token <span class="text-gray-600">(optional - for interactive approval)</span></label>
          <input type="password" name="value" placeholder="Bot token..."
                 class="w-full bg-gray-800 border border-gray-700 rounded-md px-3 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500" />
        </div>
        <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded-md text-sm font-medium transition-colors">
          Save
        </button>
      </form>
    </div>
  </div>

  <!-- SocialAPI.ai -->
  <div class="bg-gray-900 border border-gray-800 rounded-lg p-6">
    <h2 class="text-sm font-medium text-gray-400 uppercase tracking-wide mb-4">SocialAPI.ai</h2>
    <p class="text-xs text-gray-500 mb-4">
      Paste your SocialAPI.ai API key, then sync to list your connected accounts.
      Enable or disable each account to control which ones the agent manages.
    </p>
    <div id="socialapi-section">
      <%- include('partials/socialapi-section', {
        socialApiKeyMasked: socialApiKeyMasked,
        socialApiAccounts: socialApiAccounts,
        socialApiError: socialApiError
      }) %>
    </div>
  </div>

  <!-- Senders -->
  <div class="bg-gray-900 border border-gray-800 rounded-lg p-6">
    <h2 class="text-sm font-medium text-gray-400 uppercase tracking-wide mb-4">Tracked Senders</h2>
    <p class="text-xs text-gray-500 mb-4">The agent will only process emails from these addresses.</p>

    <!-- Add Sender Form -->
    <form hx-post="/api/senders" hx-target="#sender-list" hx-swap="innerHTML"
          class="flex gap-3 mb-4"
          hx-on::after-request="this.reset()">
      <input type="email" name="email" placeholder="sender@example.com" required
             class="flex-1 bg-gray-800 border border-gray-700 rounded-md px-3 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500" />
      <input type="text" name="label" placeholder="Label (optional)"
             class="w-40 bg-gray-800 border border-gray-700 rounded-md px-3 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500" />
      <button type="submit" class="px-4 py-2 bg-green-600 hover:bg-green-500 rounded-md text-sm font-medium transition-colors">
        Add
      </button>
    </form>

    <!-- Sender List -->
    <div id="sender-list">
      <%- include('partials/sender-list', { senders: senders }) %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
