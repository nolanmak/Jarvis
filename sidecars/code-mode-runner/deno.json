{
  "lock": false,
  "nodeModulesDir": "none",
  "imports": {},
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.ns",
      "deno.window",
      "esnext"
    ],
    "noImplicitAny": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "semiColons": true,
    "singleQuote": false
  },
  "tasks": {
    "run": "deno run runner.ts",
    "test": "deno test --allow-run --allow-read=. --no-prompt runner_test.ts"
  },
  "_minDenoVersion": "2.7.0",
  "_note": "Development configuration only. Production uses --no-config, --no-npm, --no-remote, --deny-import and --no-prompt with no capability grants."
}
