diff --git a/open-sse/translator/concerns/namespacedTools.js b/open-sse/translator/concerns/namespacedTools.js
new file mode 100644
index 0000000..6d8dfbe
--- /dev/null
+++ b/open-sse/translator/concerns/namespacedTools.js
@@ -0,0 +1,101 @@
+import { createHash } from "node:crypto";
+
+// Chat Completions has no namespace container. Give each leaf a stable,
+// collision-checked alias and restore its Responses identity at the boundary.
+export function flattenNamespaces(body) {
+  const identities = new Map();
+  const used = new Set((body.tools || []).filter(t => t.type !== "namespace")
+    .map(t => t.name || t.function?.name).filter(Boolean));
+  const aliasFor = (namespace, name) => {
+    if (typeof namespace !== "string" || !namespace || typeof name !== "string" || !name)
+      throw new Error("Invalid namespace tool");
+    const digest = createHash("sha256").update(JSON.stringify([namespace, name])).digest("hex").slice(0, 24);
+    const alias = `ns_${digest}_${name.replace(/[^a-zA-Z0-9_-]/g, "_").slice(0, 30)}`;
+    if (used.has(alias)) throw new Error("Namespace tool name collision");
+    identities.set(alias, { namespace, name });
+    return alias;
+  };
+  const flatten = tools => tools.flatMap(tool => {
+    if (tool.type !== "namespace") return [tool];
+    if (!Array.isArray(tool.tools)) throw new Error("Invalid namespace tools");
+    return tool.tools.map(leaf => {
+      if (!["function", "custom"].includes(leaf.type)) throw new Error("Unsupported namespace tool");
+      const name = aliasFor(tool.name, leaf.name);
+      const result = { ...leaf, name, description: [tool.description, leaf.description].filter(Boolean).join("\n") };
+      delete result.defer_loading;
+      return result;
+    });
+  });
+  const tools = flatten(body.tools || []);
+  const input = Array.isArray(body.input) ? body.input.map(item => {
+    if (["function_call", "custom_tool_call"].includes(item.type) && item.namespace) {
+      const result = { ...item, name: aliasFor(item.namespace, item.name) };
+      delete result.namespace;
+      return result;
+    }
+    return item;
+  }) : body.input;
+  let choice = body.tool_choice;
+  if (choice && typeof choice === "object" && choice.namespace) {
+    choice = { ...choice, name: aliasFor(choice.namespace, choice.name) };
+    delete choice.namespace;
+  }
+  return { body: { ...body, tools, input, ...(choice ? { tool_choice: choice } : {}) }, identities };
+}
+
+export function restoreNamespaces(value, identities) {
+  if (Array.isArray(value)) return value.map(v => restoreNamespaces(v, identities));
+  if (!value || typeof value !== "object") return value;
+  const result = Object.fromEntries(Object.entries(value).map(([k, v]) => [k, restoreNamespaces(v, identities)]));
+  if (["function_call", "custom_tool_call"].includes(result.type) && identities.has(result.name))
+    Object.assign(result, identities.get(result.name));
+  return result;
+}
+
+function restoreSSE(identities) {
+  const decoder = new TextDecoder();
+  const encoder = new TextEncoder();
+  let pending = "";
+  const event = block => {
+    const lines = block.split(/\r?\n/);
+    const data = lines.filter(l => l.startsWith("data:")).map(l => l.slice(5).trimStart()).join("\n");
+    if (!data || data === "[DONE]") return block + "\n\n";
+    const value = restoreNamespaces(JSON.parse(data), identities);
+    return lines.filter(l => !l.startsWith("data:")).concat("data: " + JSON.stringify(value)).join("\n") + "\n\n";
+  };
+  const emit = controller => {
+    let match;
+    while ((match = /\r?\n\r?\n/.exec(pending))) {
+      controller.enqueue(encoder.encode(event(pending.slice(0, match.index))));
+      pending = pending.slice(match.index + match[0].length);
+    }
+  };
+  return new TransformStream({
+    transform(chunk, controller) { pending += decoder.decode(chunk, { stream: true }); emit(controller); },
+    flush(controller) {
+      pending += decoder.decode(); emit(controller);
+      if (pending.trim()) controller.enqueue(encoder.encode(event(pending)));
+    },
+  });
+}
+
+export async function handleNamespacedResponses(request, handler) {
+  let original;
+  try { original = await request.clone().json(); }
+  catch { return handler(request); }
+  if (!original.tools?.some(tool => tool.type === "namespace")) return handler(request);
+  let normalized;
+  try { normalized = flattenNamespaces(original); }
+  catch { return Response.json({ error: { message: "Invalid namespace tools" } }, { status: 400 }); }
+  const headers = new Headers(request.headers);
+  headers.delete("content-length");
+  const forwarded = new Request(request, { headers, body: JSON.stringify(normalized.body) });
+  const response = await handler(forwarded);
+  if (!response.ok || !response.body) return response;
+  const outgoing = new Headers(response.headers);
+  outgoing.delete("content-length");
+  const streaming = (outgoing.get("content-type") || "").includes("text/event-stream");
+  const body = streaming ? response.body.pipeThrough(restoreSSE(normalized.identities))
+    : JSON.stringify(restoreNamespaces(await response.json(), normalized.identities));
+  return new Response(body, { status: response.status, headers: outgoing });
+}
