{
  "name": "@augmentagent/fetch-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Layered URL fetch sidecar — tries plain HTTPS, headless render, Firecrawl, Bright Data in order. NDJSON over Unix socket.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts",
    "smoke": "node dist/smoke.js",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "playwright": "^1.65.0",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
