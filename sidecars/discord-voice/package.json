{
  "name": "augmentagent-discord-voice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "./node_modules/node/bin/node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && ./node_modules/node/bin/node --test dist/test/*.test.js",
    "doctor": "./node_modules/node/bin/node dist/scripts/doctor.js",
    "test:live": "./node_modules/node/bin/node dist/scripts/live-voice.js",
    "report:latency": "./node_modules/node/bin/node dist/scripts/latency-report.js"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@snazzah/davey-linux-x64-gnu": "0.1.12",
    "ffmpeg-static": "5.3.0",
    "node": "26.12.0",
    "opusscript": "0.1.1",
    "prism-media": "1.3.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
