# Copy to ~/.config/augmentagent/discord-voice.env, mode 0600.
# Only provider credentials belong here. Never add DISCORD_BOT_TOKEN.
AUGMENTAGENT_DISCORD_STT_PROVIDER=deepgram
AUGMENTAGENT_DISCORD_TTS_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# For ElevenLabs STT or TTS, set the provider independently above and fill:
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
