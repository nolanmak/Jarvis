node_modules/
dist/
target/

# All wiki content is user-private runtime data.
wiki/

.env
.env.*
!.env.example

# Browser session-cookie profile dirs — live session cookies.
# Never commit; treat as secret.
**/chrome-profile/
**/*-chrome-profile/

# Webhook spool + dedupe ledger — local runtime state, may contain PII.
augmentagent-webhooks.jsonl
augmentagent-deft-seen.jsonl

*.db
*.db-shm
*.db-wal
skills/*/learned/*
!skills/*/learned/.gitkeep
skills/*/config.json

# LinkedIn session cookies — treat as secret.
linkedin-auth.json
linkedin-cookies.json

# X / Twitter session cookies — treat as secret.
twitter-auth.json
twitter-session.json

# Instagram session cookies — treat as secret.
instagram-auth.json
instagram-cookies.json

# Rotated .env snapshots hold the same secrets as .env itself.
.env.bak*

# Discord user-token + super-properties — treat as secret. Vault location
# (/Volumes/augmentagent/discord-creds.json) is outside the repo.
discord-creds.json

# Claude Code harness runtime state — local to each machine, never tracked.
# Exception: `.claude/settings.json` carries the project-level PR-verify
# hook (#216) and MUST be tracked so every clone gets the same gate.
# Pattern note: git re-includes a tracked file even inside an ignored dir
# only if the parent dir itself isn't excluded — so we narrow `.claude/`
# to its real children rather than blanket-ignoring the directory.
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/agent-test-receipts/
.claude/self-audit-log.md

# Host-local operator instructions for Claude Code. Contains operator PII
# (emails, home paths, host layout) — stays out of the public repo (#305).
CLAUDE.md

# Tailwind build artifact — regenerated by `npm run build` from
# tailwind.input.css + views/. Source is committed; output isn't.
public/tailwind.css

# Auto-PR pipeline scratch: a per-attempt `git worktree` the daemon creates,
# force-recreates, and deletes (#630/#692). Never a source of tracked files —
# and if it leaks past a crash it must not make the deploy tree look dirty.
.self-improve-worktrees/

# Interrupted credential exports and local security-audit reports.
*-auth.json.tmp
*-cookies.json.tmp
gitleaks-report.*

# Cross-process finance importer lock (no content).
*.finance.lock
*.db-journal

# Private iMessage exports/config and Python bytecode (export outside checkout).
conversations/
.sync_state.json
.sync.lock
scripts/imessage/config.json
__pycache__/
