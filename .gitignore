node_modules/
dist/
target/

# Wiki content is user-private by default. The grocery KG scaffold is an
# exception — it ships in the repo so `kg_read("staples.md")` works on a
# fresh checkout. User-authored order records under wiki/groceries/orders/
# stay untracked except for the .gitkeep that pins the directory.
wiki/*
!wiki/groceries/
wiki/groceries/*
!wiki/groceries/staples.md
!wiki/groceries/preferences.md
!wiki/groceries/pantry.md
!wiki/groceries/dislikes.md
!wiki/groceries/orders/
wiki/groceries/orders/*
!wiki/groceries/orders/.gitkeep

.env
.env.*

# Browser/grocery session-cookie profile dirs — live session cookies
# (Giant, social, Gmail). Never commit; treat as secret.
**/chrome-profile/
**/*-chrome-profile/

# Webhook spool + dedupe ledger — local runtime state, may contain PII.
augmentagent-webhooks.jsonl
augmentagent-deft-seen.jsonl

*.db
*.db-shm
*.db-wal
skills/*/learned/*
!skills/*/learned/.gitkeep
skills/*/config.json

# LinkedIn session cookies — treat as secret.
linkedin-auth.json
linkedin-cookies.json

# X / Twitter session cookies — treat as secret.
twitter-auth.json
twitter-session.json

# Discord user-token + super-properties — treat as secret. Vault location
# (/Volumes/augmentagent/discord-creds.json) is outside the repo.
discord-creds.json

# Claude Code harness runtime state — local to each machine, never tracked.
# Exception: `.claude/settings.json` carries the project-level PR-verify
# hook (#216) and MUST be tracked so every clone gets the same gate.
# Pattern note: git re-includes a tracked file even inside an ignored dir
# only if the parent dir itself isn't excluded — so we narrow `.claude/`
# to its real children rather than blanket-ignoring the directory.
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/agent-test-receipts/

# Tailwind build artifact — regenerated by `npm run build` from
# tailwind.input.css + views/. Source is committed; output isn't.
public/tailwind.css
