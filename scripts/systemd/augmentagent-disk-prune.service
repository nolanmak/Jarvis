# User unit (%h = your home). Install with its .timer into ~/.config/systemd/user/.
[Unit]
Description=AugmentAgent — daily housekeeping: build output, temp files, logs, deploy snapshots
Documentation=https://github.com/nolanmak/Jarvis/issues/1406

[Service]
Type=oneshot
WorkingDirectory=%h/AugmentAgent
EnvironmentFile=-%h/AugmentAgent/.env
# Skips any target dir a running build is using, so it never needs to be
# scheduled around the auto-PR loop.
ExecStart=%h/AugmentAgent/target/release/augmentagent disk prune
# #1413 — rotate and compress the state dir's logs and sinks.
ExecStart=%h/AugmentAgent/target/release/augmentagent log-rotate
# #1410 — the same pass expires old deploy snapshots and rollback binaries.
ExecStart=%h/AugmentAgent/target/release/augmentagent deploy prune
# Housekeeping must not compete with a build for the disk or the CPU.
Nice=19
IOSchedulingClass=idle
# append: does not create parent dirs; StateDirectory does (as in siblings).
StateDirectory=augmentagent
StandardOutput=append:%h/.local/state/augmentagent/disk-prune.log
StandardError=append:%h/.local/state/augmentagent/disk-prune.log
