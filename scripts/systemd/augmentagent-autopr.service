# Managed by ensure-autopr-worker.sh
[Unit]
Description=AugmentAgent independent auto-ship worker
After=network-online.target augmentagent.service
Wants=network-online.target
# The worker exits 75 to load each deploy, and the updater restarts the
# daemon in the same second. systemd's default (5 starts / 10 s) counted
# those overlapping upgrade starts as a crash loop and left the worker
# dead (start-limit-hit, 2026-11-04). Allow upgrade bursts; a real crash
# loop (RestartSec=3) still stops after 10 starts in a minute.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@WORKING_DIR@
ExecStart="@REPO_ROOT@/scripts/run-rs.sh" auto-pr-worker --dry-run @DRY_RUN@
Environment="PATH=@SERVICE_PATH@"
Environment=RUST_LOG=info
@EXTRA_ENV@
Slice=augmentagent-runtime.slice
MemoryHigh=@MEMORY_HIGH@
MemoryMax=@MEMORY_MAX@
MemorySwapMax=0
TasksMax=@TASKS_MAX@
@CPU_QUOTA@
@DELEGATION@
Restart=on-failure
SuccessExitStatus=75
RestartForceExitStatus=75
RestartSec=3
LimitNOFILE=@NOFILE@
# Preserve the existing health/log-rotation consumers for both processes.
StandardOutput=append:@LOG_DIR@/stdout.log
StandardError=append:@LOG_DIR@/stderr.log

[Install]
WantedBy=default.target
