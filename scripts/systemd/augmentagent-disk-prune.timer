[Unit]
Description=Hourly AugmentAgent housekeeping (build output, temp files, logs, deploy snapshots)

[Timer]
# Wall-clock, so a suspended laptop catches up instead of drifting. Hourly,
# not daily: a busy day of builds could fill a disk between daily passes, and
# a pass with nothing to reclaim is cheap.
OnCalendar=*-*-* *:37:00
# Catch a miss after a reboot or a long sleep.
Persistent=true
AccuracySec=5min

[Install]
WantedBy=timers.target
