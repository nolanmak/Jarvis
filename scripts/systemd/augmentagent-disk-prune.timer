[Unit]
Description=Daily AugmentAgent housekeeping (build output, temp files, logs, deploy snapshots)

[Timer]
# Wall-clock, so a suspended laptop catches up instead of drifting.
OnCalendar=*-*-* 04:37:00
# Catch a miss after a reboot or a long sleep.
Persistent=true
AccuracySec=5min

[Install]
WantedBy=timers.target
