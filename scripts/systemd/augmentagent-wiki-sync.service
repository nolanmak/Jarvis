[Unit]
Description=AugmentAgent knowledge-base mirror sync (wiki/ <-> private GitHub repo)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/AugmentAgent
# Two-way sync: commit local KB changes, pull owner edits (owner-wins), push.
ExecStart=%h/AugmentAgent/target/release/augmentagent --wiki-dir ./wiki wiki sync
# gh (credential helper) lives in ~/.local/bin; git in /usr/bin.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=RUST_LOG=info
# KB commits are authored from AUGMENTAGENT_GIT_AUTHOR_NAME/EMAIL, loaded
# from ./.env via WorkingDirectory (no PII hardcoded in this template).
StateDirectory=augmentagent
StandardOutput=append:%h/.local/state/augmentagent/wiki-sync.log
StandardError=append:%h/.local/state/augmentagent/wiki-sync.log
