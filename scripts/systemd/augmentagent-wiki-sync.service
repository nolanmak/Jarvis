[Unit]
Description=AugmentAgent knowledge-base mirror sync (wiki/ <-> private GitHub repo)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/nolan-makatche/AugmentAgent
# Two-way sync: commit local KB changes, pull owner edits (owner-wins), push.
ExecStart=/home/nolan-makatche/AugmentAgent/target/release/augmentagent --wiki-dir ./wiki wiki sync
# gh (credential helper) lives in ~/.local/bin; git in /usr/bin.
Environment=PATH=/home/nolan-makatche/.local/bin:/home/nolan-makatche/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=RUST_LOG=info
# KB commits are authored from AUGMENTAGENT_GIT_AUTHOR_NAME/EMAIL, loaded
# from ./.env via WorkingDirectory (no PII hardcoded in this template).
StandardOutput=append:/home/nolan-makatche/.local/state/augmentagent/wiki-sync.log
StandardError=append:/home/nolan-makatche/.local/state/augmentagent/wiki-sync.log
